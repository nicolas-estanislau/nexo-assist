# Copie para .env e preencha. Nunca faça commit do .env.

# --- LLM (Google Gemini) ---
# Crie a chave em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo do agent no formato do Mastra (provedor/modelo). Ver README para a escolha.
LLM_MODEL=google/gemini-3.5-flash

# --- App web ---
WEB_PORT=3000
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
APP_DATABASE_URL=file:./data/app.db

# --- Serviço de chamados (legado simulado) ---
TICKETS_API_PORT=4000
TICKETS_API_URL=http://localhost:4000
# Token compartilhado entre o app e o serviço; só quem tem o token chama a API
TICKETS_API_TOKEN=troque-por-um-token-aleatorio
# Caminho relativo à pasta apps/tickets-api
TICKETS_DATABASE_URL=file:./data/tickets.db
# Probabilidade (0 a 1) de cada requisição derrubar o serviço por alguns segundos
TICKETS_FAILURE_RATE=0.05
# Por quantos segundos o serviço fica indisponível quando cai
TICKETS_OUTAGE_SECONDS=3
# Latência extra simulada, em ms
TICKETS_LATENCY_MS=150

# --- Limites ---
MAX_MESSAGES_PER_SESSION=30
